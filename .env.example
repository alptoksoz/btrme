# Database
DATABASE_URL="postgresql://user:password@localhost:5432/btrme?schema=public"
REDIS_URL="redis://localhost:6379"

# AI APIs
ANTHROPIC_API_KEY="sk-ant-api03-..."
OPENAI_API_KEY="sk-..." # For embeddings

# Authentication
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Deployment
FLY_API_TOKEN=""
FLY_ORG=""
DOCKER_REGISTRY=""

# Storage (S3-compatible)
S3_ENDPOINT=""
S3_BUCKET="btrme-assets"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"

# Monitoring & Logging
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
BETTERSTACK_TOKEN=""

# Vector Database (for template matching)
PINECONE_API_KEY=""
PINECONE_ENVIRONMENT=""
PINECONE_INDEX_NAME="btrme-templates"

# Rate Limiting
RATE_LIMIT_PROMPTS_PER_HOUR="10"
RATE_LIMIT_DEPLOYMENTS_PER_HOUR="5"

# Feature Flags
ENABLE_TEAM_FEATURES="false"
ENABLE_CUSTOM_DOMAINS="false"
ENABLE_DATABASE_PER_APP="false"

# App Configuration
APP_NAME="BTRMe"
APP_URL="https://btrme.app"
GENERATED_APPS_DOMAIN="btrme.app"
GENERATED_APPS_SUBDOMAIN_PATTERN="*.btrme.app"

# Build Configuration
MAX_BUILD_TIME_SECONDS="300"
MAX_CONTAINER_SIZE_MB="150"
BUILD_CONCURRENCY="5"

# Cost Limits (optional)
MAX_AI_COST_PER_USER_MONTHLY="10"
MAX_STORAGE_PER_USER_MB="500"

# Development
NODE_ENV="development"
LOG_LEVEL="debug"
ENABLE_DEBUG_MODE="true"
